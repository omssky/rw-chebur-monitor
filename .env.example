# Remnawave HTTPS base URL, without /api. Use a separate read-only API token.
REMNAWAVE_URL=https://panel.example.com
REMNAWAVE_API_TOKEN=replace-me

# Telegram forum group and topic; the bot must be allowed to send messages there.
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_THREAD_ID=123

CHECK_INTERVAL=30m
CONFIRM_DELAY=3m
DB_PATH=/data/monitor.db
